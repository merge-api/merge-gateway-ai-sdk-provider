{
  "name": "merge-gateway-ai-sdk-provider",
  "version": "0.2.1",
  "description": "Merge Gateway provider for the Vercel AI SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./v5": {
      "import": {
        "types": "./dist/v5/index.d.mts",
        "default": "./dist/v5/index.mjs"
      },
      "require": {
        "types": "./dist/v5/index.d.ts",
        "default": "./dist/v5/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "v5": [
        "./dist/v5/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "merge",
    "gateway",
    "ai",
    "ai-sdk",
    "vercel",
    "llm",
    "openai",
    "anthropic",
    "provider"
  ],
  "author": "Merge <support@merge.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/merge-api/merge-gateway-ai-sdk-provider"
  },
  "homepage": "https://github.com/merge-api/merge-gateway-ai-sdk-provider",
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.23",
    "ai": "6.0.157",
    "typescript": "~5.7.0",
    "vitest": "3.0.0",
    "tsup": "8.5.1",
    "zod": "4.3.6"
  }
}
